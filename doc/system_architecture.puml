@startuml system_architecture
!pragma layout smetana
title Fire extinguisher detection, decoy rejection and 3D localization: system architecture

top to bottom direction
skinparam shadowing false
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor #F5F7FA
  BorderColor #4A6FA5
  RoundCorner 8
}
skinparam package {
  BorderColor #888888
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
skinparam ArrowColor #4A6FA5

package "OFFLINE: detector training (once)" {
  rectangle "Roboflow FireExtinguisher v2\n2,934 train / 328 valid images\n1 class, CC BY 4.0" as rf
  rectangle "Augmentation during training\nflip, HSV, scale, translate,\nmosaic (Ultralytics defaults)" as aug
  rectangle "YOLO11 fine-tuning\n(pretrained COCO weights)" as train
  rectangle "Trained weights\nbest.pt" as weights
  rf --> aug
  aug --> train
  train --> weights
}

package "ONLINE: every frame" {
  rectangle "Orbbec stereo depth camera\ncolour PNG 640x400\ndepth PNG uint16 mm (aligned to colour)\ncalibration K" as cam
  rectangle "Frame pairing\ncolour <-> nearest depth\n(time gap <= 50 ms)" as pair
  rectangle "Depth pre-processing\nmm -> metres, 0 = missing" as depthpre
  rectangle "YOLO11 detector\nboxes (x1, y1, x2, y2) + confidence\nconf >= 0.1" as det
  rectangle "Object pixels per box\ndepth histogram: keep pixels near\nthe tallest bar (-0.05 / +0.15 m)" as objpix
  rectangle "Real vs decoy filter (Task 2)\nbox height (m) >= 0.56\nAND ring around the box >= 19 % further\n-> real (1) / decoy (0)" as decoy
  rectangle "3D localization\nfront = 5th percentile depth\ncentre = front + radius (0.067 m)\nX = (u - cx) Z / fx,  Y = (v - cy) Z / fy" as loc
  rectangle "Floor plane (RANSAC)\nheight above floor (3D check)" as floor
  rectangle "Tracking (extension)\nkeeps a confirmed real object\nthrough 1-2 rejected frames\nmatch: <= 80 px, similar box height" as track
  rectangle "OUTPUT\naccepted real extinguishers\nX, Y, Z (m), camera frame" as out

  cam --> pair
  pair --> det : colour
  pair --> depthpre : depth
  weights ..> det : loads
  det --> objpix : boxes
  depthpre --> objpix
  det --> decoy : boxes
  depthpre --> decoy
  objpix --> loc
  depthpre --> floor
  decoy --> track : real / decoy
  loc --> track : X, Y, Z
  track --> out
}

package "EVALUATION (test recording, 67 paired frames, run once)" {
  rectangle "Reference labels\nreal / decoy boxes" as labels
  rectangle "Baseline\nevery detection accepted as real\n3D = median depth of the box" as base
  rectangle "Metrics (same data, same rules)\nreal-object TPR (target >= 0.75)\ndecoy FPR (target <= 0.15)\nraw counts: TP, FN, decoy FP\nmatch: box centre inside reference box\n3D check: height above floor" as metrics
  labels --> metrics
  base --> metrics
}

det ..> base : same boxes
out --> metrics : final system
floor ..> metrics : height

note right of cam
  3D coordinate system:
  colour camera optical frame
  X right, Y down, Z forward, metres
end note

note right of decoy
  Thresholds fitted on the eval
  recording (development), frozen,
  then run once on test
end note

@enduml
